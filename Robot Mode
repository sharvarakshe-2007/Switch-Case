#include <stdio.h>
 int main()

{

int mode;

printf("Enter Robot mode(1-3): ");

scanf("%d", &mode);
switch(mode)

{

case 1:

printf("Robot is in IDLE mode.");

break;

case 2:

printf("Robot is in ACTIVE mode.");

break;
case 3:

printf("Robot is in ERROR mode.");

break;

default:

printf("Invalid mode selected.");
}
return 0;

}